# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=

# Pin the endpoint. Some machines carry an ANTHROPIC_BASE_URL pointing at a
# third-party Anthropic-compatible proxy; .env wins over the shell, so this
# keeps a real Anthropic key from being sent somewhere that will reject it.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Durable counter store. A local file today; swap for a Turso URL + token when
# you need a hosted replica (the SQL is unchanged, only the driver differs).
SQLITE_PATH=./data/analytics.db
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Delivery (your side — real credentials, not committed)
RESEND_API_KEY=
# Sender address. Without this the shared onboarding@resend.dev sender is used,
# which Resend only permits to mail the account owner's own address. Set a
# verified domain before mailing a real customer.
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
