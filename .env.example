# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=

# Durable counter store. A local file today; swap for a Turso URL + token when
# you need a hosted replica (the SQL is unchanged, only the driver differs).
SQLITE_PATH=./data/analytics.db
